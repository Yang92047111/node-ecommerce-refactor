# Test Environment Configuration

# Server Configuration
HOST=127.0.0.1
PORT=0
RUST_LOG=debug,rust_ecommerce=trace,sqlx=debug

# Database Configuration (Testcontainers will override)
DATABASE_URL=postgres://test_user:test_password@localhost:5432/test_ecommerce_db
DATABASE_MAX_CONNECTIONS=5
DATABASE_MIN_CONNECTIONS=1

# JWT Configuration (Test keys)
JWT_SECRET=test-jwt-secret-key-for-testing-only
JWT_EXPIRATION_HOURS=1
REFRESH_TOKEN_SECRET=test-refresh-token-secret-key-for-testing-only
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Password Hashing Configuration (Lower for faster tests)
ARGON2_MEMORY_COST=4096
ARGON2_TIME_COST=1
ARGON2_PARALLELISM=1

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# Disable rate limiting in tests
RATE_LIMIT_PER_SECOND=1000
RATE_LIMIT_BURST_SIZE=2000

# Test mode
TEST_MODE=true
